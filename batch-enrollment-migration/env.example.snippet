# --- Two-gate registration (BFF + MongoDB) — REQUIRED for batch enrollment ---
BFF_REGISTRATION_MONGODB_URI=mongodb://127.0.0.1:27017/enrollment_bff
BFF_REGISTRATION_JWT_SECRET=replace-with-strong-secret

# Public site URL for verification links (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: verification link path (default /verify-email)
# BFF_REGISTRATION_VERIFY_PATH=/verify-email

# MongoDB connection helpers (optional)
# BFF_MONGOOSE_IPV4_ONLY=1
# BFF_MONGOOSE_DNS_SERVERS=8.8.8.8,1.1.1.1
# BFF_MONGOOSE_DNS_AUTO_PUBLIC=0

# SMTP (production — without these, emails log to console in dev)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Enrollment <no-reply@yourdomain.com>"

# BFF admin seed (npm run seed:bff-admin)
# BFF_SEED_ADMIN_EMAIL=admin@local.dev
# BFF_SEED_ADMIN_PASSWORD=your-strong-password
# BFF_SEED_ADMIN_ROTATE=1

# --- Batch 4 application form ---
BFF_BATCH_BKASH_NUMBER=01864494184
BFF_BATCH_EARLY_BIRD_DEADLINE=2026-06-22T23:59:59+06:00
BFF_BATCH_EARLY_BIRD_AMOUNT=9900
BFF_BATCH_REGULAR_AMOUNT=13900
